PORT=3000
NODE_ENV=development
# Public base URL of this API, used to build the link in verification emails
APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=marketplace

# Generate each secret separately:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFICATION_SECRET=

# Local development: Mailpit (docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Marketplace <no-reply@marketplace.local>"
